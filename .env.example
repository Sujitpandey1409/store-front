# Copy to .env.local only when you are ready to connect your own services.
# The storefront preview runs without this file.

# MongoDB Atlas or another MongoDB connection string. Keep private.
DATABASE_URI=

# Payment settings are intentionally empty/off. Use your own Razorpay credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Must remain false until real product, shipping, tax and customer operations are ready.
STORE_CHECKOUT_ENABLED=false

# Required after checkout is deliberately enabled; amount is in paise (100 paise = ₹1).
# Set this to the real, reviewed flat shipping amount. Do not leave blank and enable checkout.
STORE_FLAT_SHIPPING_CHARGE_PAISE=
